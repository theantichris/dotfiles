#!/bin/bash

MUTED=0xff{{ trimPrefix "#" .cyberpunk.text.muted }}
PINK=0xff{{ trimPrefix "#" .cyberpunk.accent.pink }}

# Resolve the Wi-Fi interface instead of assuming en0.
device="$(networksetup -listallhardwareports | awk '/Hardware Port: (Wi-Fi|AirPort)/ { getline; print $2; exit }')"

icon="󰖪"
color="$PINK"
label="offline"
label_drawing="on"

if [ -n "$device" ]; then
  status="$(ifconfig "$device" 2>/dev/null | awk '$1 == "status:" { print $2; exit }')"
  address="$(ipconfig getifaddr "$device" 2>/dev/null)"

  if [ "$status" = "active" ] && [ -n "$address" ]; then
    icon="󰖩"
    color="$MUTED"
    label=""
    label_drawing="off"
  fi
fi

sketchybar --set "$NAME" \
  icon="$icon" \
  icon.color="$color" \
  label="$label" \
  label.color="$color" \
  label.drawing="$label_drawing"
