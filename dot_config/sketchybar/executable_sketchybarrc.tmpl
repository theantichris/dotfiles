#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
PLUGIN_DIR="$CONFIG_DIR/plugins"

BASE=0xff{{ trimPrefix "#" .cyberpunk.background.base }}
PANEL=0xff{{ trimPrefix "#" .cyberpunk.background.panel }}
ACTIVE=0xff{{ trimPrefix "#" .cyberpunk.background.active }}
TEXT=0xff{{ trimPrefix "#" .cyberpunk.text.primary }}
MUTED=0xff{{ trimPrefix "#" .cyberpunk.text.muted }}
PINK=0xff{{ trimPrefix "#" .cyberpunk.accent.pink }}
CYAN=0xff{{ trimPrefix "#" .cyberpunk.accent.cyan }}

# Dark, quiet shell with restrained neon accents, matching the CachyOS palette.
# Keep the shell opaque so the native menu bar and windows underneath cannot bleed through.
sketchybar --bar position=top height=34 blur_radius=0 color="$BASE" topmost=window

default=(
  padding_left=6
  padding_right=6
  icon.font="Hack Nerd Font:Bold:13.0"
  label.font="Hack Nerd Font:Regular:13.0"
  icon.color="$TEXT"
  label.color="$TEXT"
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

# Date/time anchors the far-left edge.
sketchybar --add item clock left \
           --set clock icon.drawing=off \
                       label.color="$CYAN" \
                       background.color="$PANEL" \
                       background.corner_radius=6 \
                       background.height=24 \
                       update_freq=10 \
                       script="$PLUGIN_DIR/clock.sh"

# AeroSpace workspaces use the same 1-0 ordering as the keyboard shortcuts.
sketchybar --add event aerospace_workspace_change
WORKSPACES=(1 2 3 4 5 6 7 8 9 0)
for sid in "${WORKSPACES[@]}"; do
  sketchybar --add item "space.$sid" left \
             --set "space.$sid" icon.drawing=off \
                                label="$sid" \
                                label.color="$MUTED" \
                                label.padding_left=7 \
                                label.padding_right=7 \
                                background.color="$ACTIVE" \
                                background.corner_radius=6 \
                                background.height=24 \
                                background.drawing=off \
                                click_script="aerospace workspace $sid" \
                                script="$PLUGIN_DIR/aerospace.sh $sid" \
             --subscribe "space.$sid" aerospace_workspace_change
done

# Current foreground application follows the workspace indicators.
sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.color="$MUTED" \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Right-side items are added in reverse because SketchyBar lays them out from the edge inward.
# Battery stays compact and changes accent based on charging/low state.
sketchybar --add item battery right \
           --set battery background.color="$PANEL" \
                         background.corner_radius=6 \
                         background.height=24 \
                         icon.color="$MUTED" \
                         label.color="$TEXT" \
                         update_freq=60 \
                         script="$PLUGIN_DIR/battery.sh"

# Volume: click toggles mute; scroll changes volume in 5% steps.
sketchybar --add item volume right \
           --set volume background.color="$PANEL" \
                        background.corner_radius=6 \
                        background.height=24 \
                        icon.color="$CYAN" \
                        label.color="$TEXT" \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change mouse.clicked mouse.scrolled

# Wi-Fi: cyan status icon; click jumps straight to Wi-Fi settings.
sketchybar --add item wifi right \
           --set wifi background.color="$PANEL" \
                      background.corner_radius=6 \
                      background.height=24 \
                      icon.color="$CYAN" \
                      label.color="$MUTED" \
                      update_freq=30 \
                      click_script='open "x-apple.systempreferences:com.apple.wifi-settings-extension"' \
                      script="$PLUGIN_DIR/wifi.sh"

# Seed workspace state immediately instead of waiting for the first switch.
if command -v aerospace >/dev/null 2>&1; then
  FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused)"
  sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$FOCUSED_WORKSPACE"
fi

sketchybar --update
