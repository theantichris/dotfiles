{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{ .cyberpunk.text.primary }}",
    "margin": 1
  },
  "block_quote": {
    "color": "{{ .cyberpunk.text.muted }}",
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{ .cyberpunk.accent.cyan }}",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "{{ .cyberpunk.accent.magenta }}"
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### "
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "{{ .cyberpunk.text.muted }}",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "{{ .cyberpunk.semantic.link }}",
    "underline": true
  },
  "link_text": {
    "color": "{{ .cyberpunk.accent.cyan }}"
  },
  "image": {
    "color": "{{ .cyberpunk.semantic.link }}",
    "underline": true
  },
  "image_text": {
    "color": "{{ .cyberpunk.text.muted }}"
  },
  "code": {
    "color": "{{ .cyberpunk.accent.green }}"
  },
  "code_block": {
    "color": "{{ .cyberpunk.text.primary }}",
    "margin": 1,
    "chroma": {
      "text": {
        "color": "{{ .cyberpunk.text.primary }}"
      },
      "error": {
        "color": "{{ .cyberpunk.semantic.error }}"
      },
      "comment": {
        "color": "{{ .cyberpunk.text.muted }}"
      },
      "comment_preproc": {
        "color": "{{ .cyberpunk.accent.pink }}"
      },
      "keyword": {
        "color": "{{ .cyberpunk.accent.magenta }}"
      },
      "keyword_type": {
        "color": "{{ .cyberpunk.accent.cyan }}"
      },
      "operator": {
        "color": "{{ .cyberpunk.accent.cyan }}"
      },
      "punctuation": {
        "color": "{{ .cyberpunk.text.primary }}"
      },
      "name": {
        "color": "{{ .cyberpunk.text.primary }}"
      },
      "name_builtin": {
        "color": "{{ .cyberpunk.accent.cyan }}"
      },
      "name_tag": {
        "color": "{{ .cyberpunk.accent.magenta }}"
      },
      "name_attribute": {
        "color": "{{ .cyberpunk.accent.cyan }}"
      },
      "name_class": {
        "color": "{{ .cyberpunk.accent.cyan }}",
        "bold": true
      },
      "name_function": {
        "color": "{{ .cyberpunk.accent.cyan }}"
      },
      "literal_number": {
        "color": "{{ .cyberpunk.syntax.number }}"
      },
      "literal_string": {
        "color": "{{ .cyberpunk.accent.green }}"
      },
      "literal_string_escape": {
        "color": "{{ .cyberpunk.semantic.warning }}"
      },
      "generic_deleted": {
        "color": "{{ .cyberpunk.semantic.error }}"
      },
      "generic_inserted": {
        "color": "{{ .cyberpunk.semantic.success }}"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "{{ .cyberpunk.text.muted }}"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "html_block": {},
  "html_span": {}
}
