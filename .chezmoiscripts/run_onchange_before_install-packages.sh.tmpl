fi
{{ range .packages.go }}
if ! command -v {{ .name | quote }} >/dev/null 2>&1 && [ ! -x "$go_bin_dir/{{ .name }}" ]; then
    go install {{ .module | quote }}
fi
{{ end }}
{{ end -}}

# Cargo packages
{{ range .packages.cargo }}
if ! cargo install --list | grep -q '^{{ . }} v'; then
    cargo install --locked {{ . | quote }}
fi
{{ end }}
{{- end }}
