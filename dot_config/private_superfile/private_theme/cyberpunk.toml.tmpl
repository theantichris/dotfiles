# Code syntax highlight theme
code_syntax_highlight = "monokai"

# ========= Border =========
file_panel_border = "{{ .cyberpunk.accent.pink }}80"
sidebar_border = "{{ .cyberpunk.background.panel }}"
footer_border = "{{ .cyberpunk.accent.pink }}80"

# ========= Border Active =========
file_panel_border_active = "{{ .cyberpunk.accent.cyan }}"
sidebar_border_active = "{{ .cyberpunk.accent.magenta }}"
footer_border_active = "{{ .cyberpunk.semantic.success }}"
modal_border_active = "{{ .cyberpunk.accent.pink }}"

# ========= Background (bg) =========
full_screen_bg = "{{ .cyberpunk.background.base }}"
file_panel_bg = "{{ .cyberpunk.background.panel }}"
sidebar_bg = "{{ .cyberpunk.background.surface }}"
footer_bg = "{{ .cyberpunk.background.panel }}"
modal_bg = "{{ .cyberpunk.background.panel }}"

# ========= Foreground (fg) =========
full_screen_fg = "{{ .cyberpunk.text.primary }}"
file_panel_fg = "{{ .cyberpunk.text.primary }}"
sidebar_fg = "{{ .cyberpunk.text.muted }}"
footer_fg = "{{ .cyberpunk.text.primary }}"
modal_fg = "{{ .cyberpunk.text.primary }}"

# ========= Special Color =========
cursor = "{{ .cyberpunk.accent.cyan }}"
correct = "{{ .cyberpunk.semantic.success }}"
error = "{{ .cyberpunk.semantic.error }}"
hint = "{{ .cyberpunk.semantic.info }}"
cancel = "{{ .cyberpunk.accent.pink }}"

# Gradient color can only have two colors!
gradient_color = ["{{ .cyberpunk.accent.cyan }}", "{{ .cyberpunk.accent.pink }}"]

# ========= File Panel Special Items =========
file_panel_top_directory_icon = "{{ .cyberpunk.semantic.success }}"
file_panel_top_path = "{{ .cyberpunk.accent.cyan }}"
file_panel_item_selected_fg = "{{ .cyberpunk.text.primary }}"
file_panel_item_selected_bg = "{{ .cyberpunk.background.active }}"

# ========= Sidebar Special Items =========
sidebar_title = "{{ .cyberpunk.accent.magenta }}"
sidebar_item_selected_fg = "{{ .cyberpunk.text.primary }}"
sidebar_item_selected_bg = "{{ .cyberpunk.background.active }}"
sidebar_divider = "{{ .cyberpunk.text.muted }}"

# ========= Modal Special Items =========
modal_cancel_fg = "{{ .cyberpunk.text.primary }}"
modal_cancel_bg = "{{ .cyberpunk.semantic.error }}"
modal_confirm_fg = "{{ .cyberpunk.background.base }}"
modal_confirm_bg = "{{ .cyberpunk.semantic.success }}"

# ========= Help Menu =========
help_menu_hotkey = "{{ .cyberpunk.accent.magenta }}"
help_menu_title = "{{ .cyberpunk.accent.cyan }}"
