{{- $parrot := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "parrot") -}}
function update --description 'Update system and development tools'
{{- if eq .chezmoi.os "android" }}
    pkg upgrade; or return
    if command -q npm
        npm update --global; or return
    end
{{- else if $parrot }}
    sudo parrot-upgrade; or return
{{- else }}
    cachy-update; or return
    shelly; or return
{{- end }}

    if command -q go-global-update
        go-global-update; or return
    end

    if command -q cargo-install-update
        cargo install-update -a; or return
    end

    if command -q gh
        gh extension upgrade --all; or return
    end
end
