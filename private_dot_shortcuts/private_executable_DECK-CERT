#!/data/data/com.termux/files/usr/bin/bash

set -u

MAGENTA='\033[38;2;202;1;116m'
CYAN='\033[38;2;0;240;255m'
GREEN='\033[38;2;0;255;156m'
YELLOW='\033[38;2;255;211;0m'
RESET='\033[0m'

clear
printf '%bDECK // TLS CERT%b\n\n' "$MAGENTA" "$RESET"

read -r -p 'Host [cloudflare.com]: ' target
target=${target:-cloudflare.com}
read -r -p 'Port [443]: ' port
port=${port:-443}

host="${target#*://}"
host="${host%%/*}"
host="${host%%:*}"

printf '\n%bTarget%b  %s:%s\n\n' "$CYAN" "$RESET" "$host" "$port"

if ! command -v openssl >/dev/null 2>&1; then
  printf '%bopenssl is not installed.%b\n' "$YELLOW" "$RESET"
else
  connection=$(timeout 12 openssl s_client -servername "$host" -connect "$host:$port" -showcerts </dev/null 2>&1)
  status=$?
  pem=$(printf '%s\n' "$connection" | awk '/-----BEGIN CERTIFICATE-----/{capture=1} capture{print} /-----END CERTIFICATE-----/{exit}')

  if (( status != 0 )) || [[ -z "$pem" ]]; then
    printf '%bCould not retrieve a TLS certificate.%b\n\n' "$YELLOW" "$RESET"
    printf '%s\n' "$connection" | tail -n 8
  else
    subject=$(openssl x509 -noout -subject -nameopt RFC2253 <<<"$pem" 2>/dev/null | sed 's/^subject=//')
    issuer=$(openssl x509 -noout -issuer -nameopt RFC2253 <<<"$pem" 2>/dev/null | sed 's/^issuer=//')
    serial=$(openssl x509 -noout -serial <<<"$pem" 2>/dev/null | sed 's/^serial=//')
    not_before=$(openssl x509 -noout -startdate <<<"$pem" 2>/dev/null | sed 's/^notBefore=//')
    not_after=$(openssl x509 -noout -enddate <<<"$pem" 2>/dev/null | sed 's/^notAfter=//')
    fingerprint=$(openssl x509 -noout -fingerprint -sha256 <<<"$pem" 2>/dev/null | sed 's/^sha256 Fingerprint=//; s/^SHA256 Fingerprint=//')
    sans=$(openssl x509 -noout -ext subjectAltName <<<"$pem" 2>/dev/null | tail -n +2 | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]][[:space:]]*/ /g')

    verify=$(printf '%s\n' "$connection" | sed -n 's/^Verify return code: //p' | tail -n 1)
    if [[ -z "$verify" ]]; then
      verify=$(printf '%s\n' "$connection" | sed -n 's/^Verification: //p' | tail -n 1)
    fi

    if openssl x509 -checkend 0 -noout <<<"$pem" >/dev/null 2>&1; then
      validity='VALID'
      VALIDITY_COLOR="$GREEN"
    else
      validity='EXPIRED'
      VALIDITY_COLOR="$YELLOW"
    fi

    printf '%b%-12s%b %b%s%b\n' "$CYAN" 'Validity' "$RESET" "$VALIDITY_COLOR" "$validity" "$RESET"
    printf '%b%-12s%b %s\n' "$CYAN" 'Verify' "$RESET" "${verify:-unknown}"
    printf '%b%-12s%b %s\n' "$CYAN" 'Subject' "$RESET" "${subject:-unknown}"
    printf '%b%-12s%b %s\n' "$CYAN" 'Issuer' "$RESET" "${issuer:-unknown}"
    printf '%b%-12s%b %s\n' "$CYAN" 'Serial' "$RESET" "${serial:-unknown}"
    printf '%b%-12s%b %s\n' "$CYAN" 'Not Before' "$RESET" "${not_before:-unknown}"
    printf '%b%-12s%b %s\n' "$CYAN" 'Not After' "$RESET" "${not_after:-unknown}"
    printf '%b%-12s%b %s\n' "$CYAN" 'SHA-256' "$RESET" "${fingerprint:-unknown}"
    printf '%b%-12s%b %s\n' "$GREEN" 'SANs' "$RESET" "${sans:---}"
  fi
fi

printf '\n'
read -r -p 'Press Enter to return home...'

am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1
