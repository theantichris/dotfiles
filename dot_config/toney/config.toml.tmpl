[general]
editor = "hx"

start_script = ["cd ~/.toney && git pull --rebase"]
stop_script = ["cd ~/.toney && git add -A && git diff --cached --quiet || (git commit -m 'update notes' && git push)"]

[keybinds.global]
up = "k"
down = "j"

[keybinds.home]
edit = "e"
scroll_up = "k"
scroll_down = "j"

[keybinds.daily]
form_up = "ctrl+k"
form_down = "ctrl+j"

[keybinds.diary]
scroll_up = "k"
scroll_down = "j"

[styles]
text = "{{ .cyberpunk.text.primary }}"
background = "{{ .cyberpunk.background.base }}"
border = "{{ .cyberpunk.accent.pink }}"
focused_border = "{{ .cyberpunk.accent.cyan }}"
menu_selected_bg = "{{ .cyberpunk.accent.cyan }}"
menu_selected_text = "{{ .cyberpunk.background.base }}"

[styles.task_styles]
focused_bar = "{{ .cyberpunk.accent.cyan }}"
unfocused_bar = "{{ .cyberpunk.background.active }}"

[styles.task_styles.completed_style]
title = "{{ .cyberpunk.semantic.success }}"
desc = "#007A4D"

[styles.task_styles.pending_style]
title = "{{ .cyberpunk.text.muted }}"
desc = "{{ .cyberpunk.background.active }}"

[styles.task_styles.started_style]
title = "{{ .cyberpunk.semantic.warning }}"
desc = "#997E00"

[styles.task_styles.abandoned_style]
title = "{{ .cyberpunk.semantic.error }}"
desc = "#7A001D"

[styles.renderer]
item_prefix = "• "
enumeration_prefix = "• "

[styles.renderer.document]
block_prefix = "\n"
block_suffix = "\n"
color = "{{ .cyberpunk.text.primary }}"
margin = 1

[styles.renderer.block_quote]
indent = 1
indent_token = "│ "
color = "{{ .cyberpunk.text.muted }}"

[styles.renderer.heading.base]
block_suffix = "\n"
color = "{{ .cyberpunk.accent.cyan }}"
bold = true

[[styles.renderer.heading.levels]]
prefix = " "
suffix = " "
color = "{{ .cyberpunk.accent.cyan }}"
background = "{{ .cyberpunk.background.base }}"
bold = true

[[styles.renderer.heading.levels]]
prefix = "## "
color = "{{ .cyberpunk.accent.cyan }}"

[[styles.renderer.heading.levels]]
prefix = "### "
color = "{{ .cyberpunk.accent.cyan }}"

[[styles.renderer.heading.levels]]
prefix = "#### "
color = "{{ .cyberpunk.accent.cyan }}"

[[styles.renderer.heading.levels]]
prefix = "##### "
color = "{{ .cyberpunk.accent.cyan }}"

[[styles.renderer.heading.levels]]
prefix = "###### "
color = "{{ .cyberpunk.accent.cyan }}"
bold = false

[styles.renderer.code]
prefix = " "
suffix = " "
color = "{{ .cyberpunk.accent.pink }}"
background = "#001a24"

[styles.renderer.code_block.text]
color = "{{ .cyberpunk.text.primary }}"
background = "{{ .cyberpunk.background.base }}"

[styles.renderer.table]
center_separator = "┼"
column_separator = "│"
row_separator = "─"

[styles.renderer.link]
color = "{{ .cyberpunk.semantic.link }}"
underline = true

[styles.renderer.image]
color = "{{ .cyberpunk.accent.magenta }}"
underline = true

[styles.renderer.emph]
italic = true
color = "{{ .cyberpunk.accent.magenta }}"

[styles.renderer.strong]
bold = true
color = "{{ .cyberpunk.text.primary }}"

[styles.renderer.strikethrough]
strikethrough = true
color = "{{ .cyberpunk.text.muted }}"
