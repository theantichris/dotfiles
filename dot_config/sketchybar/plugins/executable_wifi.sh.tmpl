#!/bin/bash

MUTED=0xff{{ trimPrefix "#" .cyberpunk.text.muted }}
PINK=0xff{{ trimPrefix "#" .cyberpunk.accent.pink }}

# Resolve the Wi-Fi interface instead of assuming en0.
device="$(networksetup -listallhardwareports | awk '/Hardware Port: (Wi-Fi|AirPort)/ { getline; print $2; exit }')"

icon="󰖪"
label="offline"
color="$PINK"

if [ -n "$device" ]; then
  ssid="$(ipconfig getsummary "$device" 2>/dev/null | awk -F ' SSID : ' '/ SSID : / { print $2; exit }')"

  if [ -z "$ssid" ]; then
    status="$(networksetup -getairportnetwork "$device" 2>/dev/null)"
    case "$status" in
      "Current Wi-Fi Network: "*)
        ssid="${status#Current Wi-Fi Network: }"
        ;;
    esac
  fi

  if [ -n "$ssid" ]; then
    icon="󰖩"
    label="$ssid"
    color="$MUTED"
  fi
fi

sketchybar --set "$NAME" \
  icon="$icon" \
  icon.color="$color" \
  label="$label" \
  label.color="$color"
