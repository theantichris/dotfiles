{{- $parrot := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "parrot") -}}
{{- if $parrot -}}
#!/bin/bash

set -euo pipefail

# {{ include "dot_config/systemd/user/ssh-add.service.tmpl" | sha256sum }}

if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
	systemctl --user daemon-reload
	systemctl --user enable --now ssh-agent.socket
	systemctl --user enable ssh-add.service
	if ! systemctl --user restart ssh-add.service; then
		echo "warning: ssh-add.service failed; check: systemctl --user status ssh-add.service" >&2
	fi
fi
{{- end }}
