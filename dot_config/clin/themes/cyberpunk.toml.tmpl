# Clin Cyberpunk theme; rendered from .chezmoidata/cyberpunk.yaml.

[chrome]
accent       = "{{ .cyberpunk.accent.pink }}"
heading      = "{{ .cyberpunk.accent.cyan }}"
success      = "{{ .cyberpunk.semantic.success }}"
warning      = "{{ .cyberpunk.semantic.warning }}"
destructive  = "{{ .cyberpunk.semantic.error }}"
muted        = "{{ .cyberpunk.text.muted }}"
text         = "{{ .cyberpunk.text.primary }}"
fg           = "{{ .cyberpunk.terminal.bright.white }}"
border       = "{{ .cyberpunk.accent.magenta }}"
tag          = "{{ .cyberpunk.accent.green }}"
folder       = "{{ .cyberpunk.semantic.info }}"
highlight_fg = "{{ .cyberpunk.background.base }}"
highlight_bg = "{{ .cyberpunk.accent.pink }}"

[graph]
nodes = [
  "{{ .cyberpunk.accent.pink }}",
  "{{ .cyberpunk.accent.cyan }}",
  "{{ .cyberpunk.accent.magenta }}",
  "{{ .cyberpunk.accent.green }}",
  "{{ .cyberpunk.semantic.warning }}",
  "{{ .cyberpunk.semantic.error }}",
  "{{ .cyberpunk.semantic.info }}",
  "{{ .cyberpunk.syntax.number }}",
]
chrome = "{{ .cyberpunk.text.muted }}"
title  = "{{ .cyberpunk.accent.cyan }}"
text   = "{{ .cyberpunk.text.primary }}"
fg     = "{{ .cyberpunk.terminal.bright.white }}"
grid   = "{{ .cyberpunk.background.surface }}"
