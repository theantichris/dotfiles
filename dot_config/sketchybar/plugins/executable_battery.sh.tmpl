#!/bin/bash

SUCCESS=0xff{{ trimPrefix "#" .cyberpunk.semantic.success }}
WARNING=0xff{{ trimPrefix "#" .cyberpunk.semantic.warning }}
ERROR=0xff{{ trimPrefix "#" .cyberpunk.semantic.error }}

battery="$(pmset -g batt | tail -1)"
percentage="$(printf '%s\n' "$battery" | grep -oE '[0-9]+%' | head -1)"
state="$(printf '%s\n' "$battery" | awk -F';' '{ gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2 }')"
level="${percentage%%%}"

icon="󰁹"
color="$SUCCESS"

case "$state" in
  charging)
    icon="󰂄"
    color="$SUCCESS"
    ;;
  charged)
    icon="󰁹"
    color="$SUCCESS"
    ;;
  *)
    if [ -n "$level" ]; then
      if [ "$level" -le 20 ]; then
        icon="󰁺"
        color="$ERROR"
      elif [ "$level" -le 50 ]; then
        color="$WARNING"
      else
        color="$SUCCESS"
      fi
    fi
    ;;
esac

sketchybar --set "$NAME" \
  icon="$icon" \
  icon.color="$color" \
  label="$percentage" \
  label.color="$color"
