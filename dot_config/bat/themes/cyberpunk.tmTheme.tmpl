<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Cyberpunk</string>
    <key>uuid</key>
    <string>cyberpunk-theme</string>
    <key>author</key>
    <string>Based on Cyberpunk Universal Palette (aligned to Helix cyberpunk syntax)</string>
    <key>semanticClass</key>
    <string>theme.dark.cyberpunk</string>

    <key>settings</key>
    <array>
        <dict>
            <key>settings</key>
            <dict>
                <key>background</key>
                <string>{{ .cyberpunk.background.base }}</string>
                <key>foreground</key>
                <string>{{ .cyberpunk.text.primary }}</string>
                <key>caret</key>
                <string>{{ .cyberpunk.accent.cyan }}</string>
                <key>selection</key>
                <string>{{ .cyberpunk.background.active }}</string>
                <key>invisibles</key>
                <string>{{ .cyberpunk.text.muted }}</string>
                <key>lineHighlight</key>
                <string>{{ .cyberpunk.background.panel }}</string>
            </dict>
        </dict>

        <dict><key>name</key><string>Comment</string><key>scope</key><string>comment</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.muted }}</string></dict></dict>
        <dict><key>name</key><string>String</string><key>scope</key><string>string</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.green }}</string></dict></dict>
        <dict><key>name</key><string>Regular expression</string><key>scope</key><string>string.regexp, string.regex</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.magenta }}</string></dict></dict>
        <dict><key>name</key><string>String escape</string><key>scope</key><string>constant.character.escape</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.green }}</string></dict></dict>
        <dict><key>name</key><string>Number</string><key>scope</key><string>constant.numeric</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.syntax.number }}</string></dict></dict>
        <dict><key>name</key><string>Built-in constant</string><key>scope</key><string>constant.language</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.green }}</string></dict></dict>
        <dict><key>name</key><string>User-defined constant</string><key>scope</key><string>constant.character, constant.other</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.green }}</string></dict></dict>
        <dict><key>name</key><string>Variable</string><key>scope</key><string>variable</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string></dict></dict>
        <dict><key>name</key><string>Keyword</string><key>scope</key><string>keyword</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.pink }}</string></dict></dict>
        <dict><key>name</key><string>Control</string><key>scope</key><string>keyword.control</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.pink }}</string></dict></dict>
        <dict><key>name</key><string>Operator</string><key>scope</key><string>keyword.operator</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.semantic.warning }}</string></dict></dict>
        <dict><key>name</key><string>Punctuation</string><key>scope</key><string>punctuation.separator, punctuation.terminator, punctuation.accessor, punctuation.section, meta.brace</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.semantic.warning }}</string></dict></dict>
        <dict><key>name</key><string>Storage</string><key>scope</key><string>storage</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.pink }}</string></dict></dict>
        <dict><key>name</key><string>Storage type</string><key>scope</key><string>storage.type</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.magenta }}</string></dict></dict>
        <dict><key>name</key><string>Class name</string><key>scope</key><string>entity.name.class</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.magenta }}</string></dict></dict>
        <dict><key>name</key><string>Namespace</string><key>scope</key><string>entity.name.namespace, meta.namespace</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.magenta }}</string></dict></dict>
        <dict><key>name</key><string>Function name</string><key>scope</key><string>entity.name.function</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.cyan }}</string></dict></dict>
        <dict><key>name</key><string>Function argument</string><key>scope</key><string>variable.parameter</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string></dict></dict>
        <dict><key>name</key><string>Tag name</string><key>scope</key><string>entity.name.tag</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.magenta }}</string></dict></dict>
        <dict><key>name</key><string>Tag attribute</string><key>scope</key><string>entity.other.attribute-name</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string></dict></dict>
        <dict><key>name</key><string>Library function</string><key>scope</key><string>support.function</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.cyan }}</string></dict></dict>
        <dict><key>name</key><string>Library constant</string><key>scope</key><string>support.constant</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.green }}</string></dict></dict>
        <dict><key>name</key><string>Library class/type</string><key>scope</key><string>support.type, support.class</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.magenta }}</string></dict></dict>
        <dict><key>name</key><string>Library variable</string><key>scope</key><string>support.other.variable</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string></dict></dict>

        <dict>
            <key>name</key><string>Invalid</string>
            <key>scope</key><string>invalid</string>
            <key>settings</key><dict><key>background</key><string>{{ .cyberpunk.semantic.error }}</string><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string></dict>
        </dict>
        <dict>
            <key>name</key><string>Invalid deprecated</string>
            <key>scope</key><string>invalid.deprecated</string>
            <key>settings</key><dict><key>background</key><string>{{ .cyberpunk.semantic.warning }}</string><key>foreground</key><string>{{ .cyberpunk.background.base }}</string></dict>
        </dict>

        <dict><key>name</key><string>JSON Key</string><key>scope</key><string>support.type.property-name.json</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string></dict></dict>

        <dict>
            <key>name</key><string>Markup Bold</string><key>scope</key><string>markup.bold</string>
            <key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string><key>fontStyle</key><string>bold</string></dict>
        </dict>
        <dict>
            <key>name</key><string>Markup Italic</string><key>scope</key><string>markup.italic</string>
            <key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.text.primary }}</string><key>fontStyle</key><string>italic</string></dict>
        </dict>
        <dict>
            <key>name</key><string>Markup Heading</string><key>scope</key><string>markup.heading</string>
            <key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.pink }}</string><key>fontStyle</key><string>bold</string></dict>
        </dict>
        <dict><key>name</key><string>Markup Link</string><key>scope</key><string>markup.underline.link</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.semantic.link }}</string></dict></dict>
        <dict><key>name</key><string>Markup Code</string><key>scope</key><string>markup.inline.raw</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.accent.green }}</string></dict></dict>
        <dict><key>name</key><string>Diff Added</string><key>scope</key><string>markup.inserted</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.semantic.success }}</string></dict></dict>
        <dict><key>name</key><string>Diff Deleted</string><key>scope</key><string>markup.deleted</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.semantic.error }}</string></dict></dict>
        <dict><key>name</key><string>Diff Changed</string><key>scope</key><string>markup.changed</string><key>settings</key><dict><key>foreground</key><string>{{ .cyberpunk.semantic.warning }}</string></dict></dict>
    </array>
</dict>
</plist>
