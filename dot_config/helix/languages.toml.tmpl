{{- $harper := ne .chezmoi.os "android" -}}
{{ if $harper -}}
[language-server.harper-ls]
command = "harper-ls"
args = ["--stdio"]

[language-server.harper-ls.config.harper-ls]
diagnosticSeverity = "hint"

{{ end -}}
[language-server.rust-analyzer.config.check]
command = "clippy"

[[language]]
name = "bash"
language-id = "shellscript"
scope = "source.sh"
file-types = [
  "sh",
  "bash",
  { glob = "**/*.sh.tmpl" },
  { glob = "**/*.bash.tmpl" },
]
shebangs = ["sh", "bash"]
language-servers = ["bash-language-server"{{ if $harper }}, "harper-ls"{{ end }}]

[[language]]
name = "go"
auto-format = true
formatter = { command = "goimports" }
language-servers = ["gopls"{{ if $harper }}, "harper-ls"{{ end }}]

[[language]]
name = "json"
auto-format = true
language-servers = ["vscode-json-language-server"{{ if $harper }}, "harper-ls"{{ end }}]

[[language]]
name = "jsonc"
auto-format = true
language-servers = ["vscode-json-language-server"{{ if $harper }}, "harper-ls"{{ end }}]

[[language]]
name = "lua"
auto-format = true
language-servers = ["lua-language-server"{{ if $harper }}, "harper-ls"{{ end }}]
file-types = [
  "lua",
  { glob = "**/*.lua.tmpl" }
]

[[language]]
name = "markdown"
language-servers = ["marksman"{{ if $harper }}, "harper-ls"{{ end }}]

[[language]]
name = "rust"
auto-format = true
language-servers = ["rust-analyzer"{{ if $harper }}, "harper-ls"{{ end }}]

[[language]]
name = "toml"
roots = ["."]
language-servers = ["taplo"{{ if $harper }}, "harper-ls"{{ end }}]

[[language]]
name = "yaml"
indent = { tab-width = 2, unit = "  " }
language-servers = ["yaml-language-server"{{ if $harper }}, "harper-ls"{{ end }}]
