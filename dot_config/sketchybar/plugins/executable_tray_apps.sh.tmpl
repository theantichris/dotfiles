#!/bin/bash

PANEL=0xff{{ trimPrefix "#" .cyberpunk.background.panel }}
CYAN=0xff{{ trimPrefix "#" .cyberpunk.accent.cyan }}
PLUGIN_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}/plugins"
STATE_FILE="${TMPDIR:-/tmp}/sketchybar_tray_apps_${UID}.state"
CURRENT_FILE="${TMPDIR:-/tmp}/sketchybar_tray_apps_${UID}.current"

: > "$CURRENT_FILE"
apps="$($PLUGIN_DIR/get_tray_apps.applescript 2>/dev/null)"
last_tray="wifi"

while IFS=$'\t' read -r app bundle_id; do
  [ -z "$app" ] && continue

  app_id="$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]' | tr ' ' '_' | tr -cd '[:alnum:]_.-')"
  [ -z "$app_id" ] && continue

  if grep -Fxq "$app_id" "$CURRENT_FILE" 2>/dev/null; then
    continue
  fi

  printf '%s\n' "$app_id" >> "$CURRENT_FILE"
  item="tray.$app_id"
  image_ref="app.$app"
  [ -n "$bundle_id" ] && image_ref="app.$bundle_id"
  printf -v quoted_app '%q' "$app"

  if ! sketchybar --query "$item" >/dev/null 2>&1; then
    sketchybar --add item "$item" right \
      --set "$item" \
        width=28 \
        padding_left=2 \
        padding_right=2 \
        icon.drawing=off \
        label.drawing=off \
        background.drawing=on \
        background.color="$PANEL" \
        background.corner_radius=6 \
        background.height=24 \
        background.image="$image_ref" \
        background.image.drawing=on \
        background.image.scale=0.55 \
        background.image.corner_radius=4 \
        click_script="$PLUGIN_DIR/tray_focus.sh $quoted_app"
  else
    sketchybar --set "$item" background.image="$image_ref"
  fi

  sketchybar --move "$item" after "$last_tray" >/dev/null 2>&1 || true
  last_tray="$item"
done <<< "$apps"

if [ -f "$STATE_FILE" ]; then
  while IFS= read -r old_id; do
    [ -z "$old_id" ] && continue
    if ! grep -Fxq "$old_id" "$CURRENT_FILE"; then
      sketchybar --remove "tray.$old_id" >/dev/null 2>&1 || true
    fi
  done < "$STATE_FILE"
fi

mv "$CURRENT_FILE" "$STATE_FILE"

# Create the system monitor once. Right-side ordering is reversed, so RAM,
# temp, CPU internally renders as CPU, temp, RAM immediately left of the tray.
if ! sketchybar --query monitor.cpu >/dev/null 2>&1; then
  MONITOR_CLICK="$HOME/.local/bin/kitty-cli-macos btop"

  sketchybar --add item monitor.ram right \
    --set monitor.ram icon="󰍛" label="--%" icon.color="$CYAN" label.color="$CYAN" \
                      padding_left=2 padding_right=4 click_script="$MONITOR_CLICK"

  sketchybar --add item monitor.temp right \
    --set monitor.temp icon="󰔏" label="--°C" \
                       padding_left=2 padding_right=2 click_script="$MONITOR_CLICK"

  sketchybar --add item monitor.cpu right \
    --set monitor.cpu icon="" label="--%" icon.color="$CYAN" label.color="$CYAN" \
                      padding_left=4 padding_right=2 update_freq=5 \
                      script="$PLUGIN_DIR/system_monitor.sh" click_script="$MONITOR_CLICK"

  sketchybar --add bracket monitor.group '/monitor\..*/' \
    --set monitor.group background.color="$PANEL" background.corner_radius=6 \
                        background.height=24 background.drawing=on
fi

sketchybar --move monitor.ram after "$last_tray" >/dev/null 2>&1 || true
sketchybar --move monitor.temp after monitor.ram >/dev/null 2>&1 || true
sketchybar --move monitor.cpu after monitor.temp >/dev/null 2>&1 || true

"$PLUGIN_DIR/system_monitor.sh" >/dev/null 2>&1 || true
