{{- $parrot := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "parrot") -}}
# Preferred applications for command-line tools
set -gx EDITOR {{ if eq .chezmoi.os "android" }}{{ includeTemplate "termux-editor" (dict "editor" .termux.editor "homeDir" .chezmoi.homeDir) | quote }}{{ else if eq .chezmoi.hostname "tranchion" }}{{ .chezmoi.homeDir }}/.local/bin/ms{{ else if $parrot }}hx{{ else }}helix{{ end }}
{{ if or (eq .chezmoi.os "android") (eq .chezmoi.hostname "tranchion") -}}
set -gx VISUAL $EDITOR
{{ end -}}
{{ if eq .chezmoi.os "android" -}}
set -gx GIT_EDITOR $EDITOR
set -gx GIT_SEQUENCE_EDITOR $EDITOR
set -gx GH_EDITOR $EDITOR
{{ end -}}
set -gx BROWSER {{ if eq .chezmoi.os "android" }}termux-open-url{{ else if $parrot }}firefox-esr{{ else }}brave-origin{{ end }}
