#!/bin/bash
set -euo pipefail

KITTY="/Applications/kitty.app/Contents/MacOS/kitty"

if [[ ! -x "$KITTY" ]]; then
    exit 1
fi

if [[ $# -eq 0 ]]; then
    exec "$KITTY"
fi

command_name="$1"
shift

# Superfile uses the macOS XDG default under ~/Library/Application Support.
# Keep its app-managed config intact, but force the shared cyberpunk theme.
if [[ "$command_name" == "spf" ]]; then
    config="$HOME/Library/Application Support/superfile/config.toml"
    if [[ -f "$config" ]]; then
        /usr/bin/sed -i '' 's/^theme = .*/theme = "cyberpunk"/' "$config"
    fi
fi

for prefix in /opt/homebrew /usr/local; do
    candidate="$prefix/bin/$command_name"
    if [[ -x "$candidate" ]]; then
        exec "$KITTY" "$candidate" "$@"
    fi
done

exec "$KITTY" "$command_name" "$@"
