#!/data/data/com.termux/files/usr/bin/bash

set -u

MAGENTA='\033[38;2;202;1;116m'
CYAN='\033[38;2;0;240;255m'
GREEN='\033[38;2;0;255;156m'
YELLOW='\033[38;2;255;211;0m'
RESET='\033[0m'

clear
printf '%bDECK // PING%b\n\n' "$MAGENTA" "$RESET"

read -r -p 'Target [1.1.1.1]: ' target
target=${target:-1.1.1.1}

printf '\n%bTarget%b  %s\n' "$CYAN" "$RESET" "$target"
printf '%bMode%b    4 probes\n\n' "$CYAN" "$RESET"

output=$(ping -c 4 "$target" 2>&1)
status=$?

printf '%s\n' "$output"

printf '\n'
if (( status == 0 )); then
  printf '%bSTATUS%b  REACHABLE\n' "$GREEN" "$RESET"
else
  printf '%bSTATUS%b  NO RESPONSE / UNREACHABLE\n' "$YELLOW" "$RESET"
fi

packet_line=$(printf '%s\n' "$output" | grep -E '[0-9]+ packets transmitted' | tail -n 1 || true)
rtt_line=$(printf '%s\n' "$output" | grep -E '(^|[[:space:]])(rtt|round-trip)[[:space:]]' | tail -n 1 || true)

if [[ -n "$packet_line" ]]; then
  printf '%bPackets%b %s\n' "$CYAN" "$RESET" "$packet_line"
fi
if [[ -n "$rtt_line" ]]; then
  printf '%bRTT%b     %s\n' "$CYAN" "$RESET" "$rtt_line"
fi

printf '\n'
read -r -p 'Press Enter to return home...'

am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1
