{{ if eq .chezmoi.hostname "tranchion" -}}
# Override the universal vi-binding setting left by CyberArch.
set -g fish_key_bindings fish_default_key_bindings
{{ end -}}
# Show Fastfetch instead of Fish's built-in welcome message.
function fish_greeting
    if command -q fastfetch
        fastfetch
    end
end

# Override CachyOS's grep alias after its startup configuration loads.
if command -q rg
    alias grep='rg'
end

# Keep autosuggestions subdued but readable against the dark terminal background.
set -g fish_color_autosuggestion {{ trimPrefix "#" .cyberpunk.text.muted }}

# Load the managed prompt even when the distribution already defines one.
if test -r "$__fish_config_dir/functions/fish_prompt.fish"
    source "$__fish_config_dir/functions/fish_prompt.fish"
end
