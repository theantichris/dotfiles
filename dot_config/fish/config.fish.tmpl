# Show Fastfetch instead of Fish's built-in welcome message.
function fish_greeting
    if command -q fastfetch
        fastfetch
    end
end

# Override CachyOS's grep alias after its startup configuration loads.
if command -q rg
    alias grep='rg'
end

# Keep autosuggestions subdued but readable against the dark terminal background.
set -g fish_color_autosuggestion {{ trimPrefix "#" .cyberpunk.text.muted }}
