# NewsBlur backend
urls-source "newsblur"
newsblur-login "theantichris"
newsblur-passwordfile "~/.config/newsboat/newsblur-password.txt"
cookie-cache "~/.config/newsboat/cookies.txt"
refresh-on-startup yes
auto-reload yes
reload-time 15

# Keep graphical browser output from overwriting the terminal interface.
browser "xdg-open %u </dev/null >/dev/null 2>&1 &"

show-read-articles no
show-read-feeds no

# Vim keybindings
unbind-key j
unbind-key k
unbind-key J
unbind-key K
unbind-key g
unbind-key G

bind-key h quit
bind-key j down
bind-key k up
bind-key l open
bind-key J next-feed
bind-key K prev-feed
bind-key g home
bind-key G end
bind-key ^D pagedown
bind-key ^U pageup

# Mark all feeds read without a modifier key.
unbind-key C
bind ma everywhere mark-all-feeds-read

# Cyberpunk theme (xterm-256 indexes are defined with the shared palette data)
color background          color{{ .cyberpunk.terminal.xterm256.text }}  default
color listnormal          color{{ .cyberpunk.terminal.xterm256.text }}  default
color listnormal_unread   color{{ .cyberpunk.terminal.xterm256.cyan }}   default  bold
color listfocus           color{{ .cyberpunk.terminal.xterm256.background }}  color{{ .cyberpunk.terminal.xterm256.pink }}  bold
color listfocus_unread    color{{ .cyberpunk.terminal.xterm256.background }}  color{{ .cyberpunk.terminal.xterm256.cyan }}   bold
color info                color{{ .cyberpunk.terminal.xterm256.background }}  color{{ .cyberpunk.terminal.xterm256.pink }}  bold
color article             color{{ .cyberpunk.terminal.xterm256.text }}  default

# Highlights
highlight article "^(Feed|Title|Author|Link|Date):.*" color{{ .cyberpunk.terminal.xterm256.cyan }} default
highlight article "https?://[^ ]+" color{{ .cyberpunk.terminal.xterm256.green }} default underline
highlight article "\\[[0-9]+\\]" color{{ .cyberpunk.terminal.xterm256.magenta }} default bold
