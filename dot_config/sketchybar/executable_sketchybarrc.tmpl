#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

BASE=0xff{{ trimPrefix "#" .cyberpunk.background.base }}
PANEL=0xff{{ trimPrefix "#" .cyberpunk.background.panel }}
TEXT=0xff{{ trimPrefix "#" .cyberpunk.text.primary }}
MUTED=0xff{{ trimPrefix "#" .cyberpunk.text.muted }}
PINK=0xff{{ trimPrefix "#" .cyberpunk.accent.pink }}
CYAN=0xff{{ trimPrefix "#" .cyberpunk.accent.cyan }}

# Dark, quiet shell with restrained neon accents, matching the CachyOS palette.
# Keep the shell opaque so the native menu bar and windows underneath cannot bleed through.
sketchybar --bar position=top height=34 blur_radius=0 color="$BASE" topmost=window

default=(
  padding_left=6
  padding_right=6
  icon.font="Hack Nerd Font:Bold:13.0"
  label.font="Hack Nerd Font:Regular:13.0"
  icon.color="$TEXT"
  label.color="$TEXT"
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

# Small machine marker so the left side reads like a console, not a stock menu bar.
sketchybar --add item host left \
           --set host icon.drawing=off \
                      label="MAC" \
                      label.color="$PINK" \
                      background.color="$PANEL" \
                      background.corner_radius=6 \
                      background.height=24 \
                      label.padding_left=8 \
                      label.padding_right=8

# Current foreground application.
sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.color="$MUTED" \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Clock lives on the right and carries the cyan secondary accent.
sketchybar --add item clock right \
           --set clock icon.drawing=off \
                       label.color="$CYAN" \
                       background.color="$PANEL" \
                       background.corner_radius=6 \
                       background.height=24 \
                       update_freq=10 \
                       script="$PLUGIN_DIR/clock.sh"

sketchybar --update
