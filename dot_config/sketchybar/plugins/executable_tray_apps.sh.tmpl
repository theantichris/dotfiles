#!/bin/bash

PANEL=0xff{{ trimPrefix "#" .cyberpunk.background.panel }}
PLUGIN_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}/plugins"
STATE_FILE="${TMPDIR:-/tmp}/sketchybar_tray_apps_${UID}.state"
CURRENT_FILE="${TMPDIR:-/tmp}/sketchybar_tray_apps_${UID}.current"

: > "$CURRENT_FILE"

apps="$($PLUGIN_DIR/get_tray_apps.applescript 2>/dev/null)"

while IFS=$'\t' read -r app bundle_id; do
  [ -z "$app" ] && continue

  app_id="$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]' | tr ' ' '_' | tr -cd '[:alnum:]_.-')"
  [ -z "$app_id" ] && continue

  if grep -Fxq "$app_id" "$CURRENT_FILE" 2>/dev/null; then
    continue
  fi

  printf '%s\n' "$app_id" >> "$CURRENT_FILE"

  item="tray.$app_id"
  image_ref="app.$app"
  [ -n "$bundle_id" ] && image_ref="app.$bundle_id"

  printf -v quoted_app '%q' "$app"

  if ! sketchybar --query "$item" >/dev/null 2>&1; then
    sketchybar --add item "$item" right \
      --set "$item" \
        width=28 \
        padding_left=2 \
        padding_right=2 \
        icon.drawing=off \
        label.drawing=off \
        background.drawing=on \
        background.color="$PANEL" \
        background.corner_radius=6 \
        background.height=24 \
        background.image="$image_ref" \
        background.image.drawing=on \
        background.image.scale=0.55 \
        background.image.corner_radius=4 \
        click_script="$PLUGIN_DIR/tray_focus.sh $quoted_app"
  else
    sketchybar --set "$item" background.image="$image_ref"
  fi

  sketchybar --move "$item" before wifi >/dev/null 2>&1 || true
done <<< "$apps"

if [ -f "$STATE_FILE" ]; then
  while IFS= read -r old_id; do
    [ -z "$old_id" ] && continue
    if ! grep -Fxq "$old_id" "$CURRENT_FILE"; then
      sketchybar --remove "tray.$old_id" >/dev/null 2>&1 || true
    fi
  done < "$STATE_FILE"
fi

mv "$CURRENT_FILE" "$STATE_FILE"
