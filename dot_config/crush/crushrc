provider add ollama --name "Ollama" --type openai --base-url "http://localhost:11434/v1/" --api-key "ollama"

model add ollama/north-mini-code-1.0 --name "North Mini Code 30B" --context-window 65536 --default-max-tokens 32768 --can-reason true --supports-images false
model add ollama/gpt-oss:120b --name "gpt-oss 120B" --context-window 65536 --default-max-tokens 32768 --can-reason true --supports-images false
model add ollama/gpt-oss:20b --name "gpt-oss 20B" --context-window 65536 --default-max-tokens 16384 --can-reason true --supports-images false
model add ollama/qwen3.5:27b --name "Qwen3.5 27B" --context-window 65536 --default-max-tokens 16384 --can-reason true --supports-images true
model add ollama/huihui_ai/gpt-oss-abliterated:20b --name "gpt-oss 20B u" --context-window 65536 --default-max-tokens 16384 --can-reason true --supports-images false
model add ollama/huihui_ai/qwen3-vl-abliterated:8b --name "Qwen3-VL 8B u" --context-window 65536 --default-max-tokens 8192 --can-reason true --supports-images true
model large ollama/north-mini-code-1.0 --temperature 0.4
model small ollama/north-mini-code-1.0

lsp add go --command gopls --filetypes go --root-markers go.mod --root-markers go.work
lsp add rust --command rust-analyzer --filetypes rust --root-markers Cargo.toml --root-markers Cargo.lock
lsp add c --command clangd --filetypes c --filetypes cpp --filetypes cc --filetypes h --filetypes hpp --root-markers compile_commands.json --root-markers .clangd --root-markers Makefile
lsp add lua --command lua-language-server --filetypes lua --root-markers .luarc.json --root-markers .git
lsp add bash --command bash-language-server --args start --filetypes sh --filetypes bash
lsp add json --command vscode-json-language-server --args --stdio --filetypes json --filetypes jsonc
lsp add yaml --command yaml-language-server --args --stdio --filetypes yaml --filetypes yml
lsp add toml --command taplo --args lsp --args stdio --filetypes toml
lsp add markdown --command marksman --args server --filetypes markdown --filetypes md

option initialize-as CRUSH.md
option context-path CRUSH.md
option context-path .crush/CRUSH.md
option auto-lsp true
option metrics false
option notifications native
option ui compact false
option ui diff split
option attribution-generated-with false

permissions allow view ls grep glob diagnostics sourcegraph fetch
