{{- $parrot := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "parrot") -}}
# Preferred applications for command-line tools
set -gx EDITOR ms
set -gx VISUAL $EDITOR
set -gx GIT_EDITOR $EDITOR
set -gx GIT_SEQUENCE_EDITOR $EDITOR
set -gx GH_EDITOR $EDITOR
set -gx BROWSER {{ if eq .chezmoi.os "android" }}termux-open-url{{ else if and $parrot (ne .chezmoi.hostname "pwntranch") }}firefox-esr{{ else }}brave-origin{{ end }}
