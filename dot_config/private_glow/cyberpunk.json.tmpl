{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{ .cyberpunk.text.primary }}",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "{{ .cyberpunk.text.muted }}"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{ .cyberpunk.accent.pink }}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{ .cyberpunk.accent.pink }}",
    "background_color": "{{ .cyberpunk.background.base }}",
    "bold": true
  },
  "h2": { "prefix": "## ", "color": "{{ .cyberpunk.accent.pink }}", "bold": true },
  "h3": { "prefix": "### ", "color": "{{ .cyberpunk.accent.pink }}", "bold": true },
  "h4": { "prefix": "#### ", "color": "{{ .cyberpunk.accent.pink }}", "bold": true },
  "h5": { "prefix": "##### ", "color": "{{ .cyberpunk.accent.pink }}", "bold": true },
  "h6": { "prefix": "###### ", "color": "{{ .cyberpunk.accent.pink }}", "bold": true },
  "text": { "color": "{{ .cyberpunk.text.primary }}" },
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true, "color": "{{ .cyberpunk.text.primary }}" },
  "strong": { "bold": true, "color": "{{ .cyberpunk.text.primary }}" },
  "hr": {
    "color": "{{ .cyberpunk.text.muted }}",
    "format": "\n--------\n"
  },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "{{ .cyberpunk.semantic.link }}", "underline": true },
  "link_text": { "color": "{{ .cyberpunk.semantic.link }}" },
  "image": { "color": "{{ .cyberpunk.semantic.link }}", "underline": true },
  "image_text": {
    "color": "{{ .cyberpunk.text.muted }}",
    "format": "Image: {{ "{{.text}}" }} →"
  },
  "code": { "color": "{{ .cyberpunk.accent.green }}" },
  "code_block": {
    "color": "{{ .cyberpunk.accent.green }}",
    "margin": 2,
    "chroma": {
      "text": { "color": "{{ .cyberpunk.text.primary }}" },
      "error": { "color": "{{ .cyberpunk.semantic.error }}", "background_color": "{{ .cyberpunk.background.base }}" },
      "comment": { "color": "{{ .cyberpunk.text.muted }}" },
      "comment_preproc": { "color": "{{ .cyberpunk.accent.pink }}" },
      "keyword": { "color": "{{ .cyberpunk.accent.pink }}" },
      "keyword_reserved": { "color": "{{ .cyberpunk.accent.pink }}" },
      "keyword_namespace": { "color": "{{ .cyberpunk.accent.pink }}" },
      "keyword_type": { "color": "{{ .cyberpunk.accent.magenta }}" },
      "keyword_constant": { "color": "{{ .cyberpunk.accent.pink }}" },
      "keyword_declaration": { "color": "{{ .cyberpunk.accent.pink }}" },
      "keyword_pseudo": { "color": "{{ .cyberpunk.accent.pink }}" },
      "name": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_attribute": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_builtin": { "color": "{{ .cyberpunk.accent.cyan }}" },
      "name_builtin_pseudo": { "color": "{{ .cyberpunk.accent.cyan }}" },
      "name_class": { "color": "{{ .cyberpunk.accent.magenta }}" },
      "name_constant": { "color": "{{ .cyberpunk.accent.green }}" },
      "name_decorator": { "color": "{{ .cyberpunk.accent.pink }}" },
      "name_entity": { "color": "{{ .cyberpunk.accent.pink }}" },
      "name_exception": { "color": "{{ .cyberpunk.semantic.error }}" },
      "name_function": { "color": "{{ .cyberpunk.accent.cyan }}" },
      "name_function_magic": { "color": "{{ .cyberpunk.accent.cyan }}" },
      "name_label": { "color": "{{ .cyberpunk.accent.cyan }}" },
      "name_namespace": { "color": "{{ .cyberpunk.accent.magenta }}" },
      "name_other": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_property": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_tag": { "color": "{{ .cyberpunk.accent.magenta }}" },
      "name_variable": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_variable_class": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_variable_global": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_variable_instance": { "color": "{{ .cyberpunk.text.primary }}" },
      "name_variable_magic": { "color": "{{ .cyberpunk.text.primary }}" },
      "literal": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_date": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_number": { "color": "{{ .cyberpunk.syntax.number }}" },
      "literal_number_bin": { "color": "{{ .cyberpunk.syntax.number }}" },
      "literal_number_float": { "color": "{{ .cyberpunk.syntax.number }}" },
      "literal_number_hex": { "color": "{{ .cyberpunk.syntax.number }}" },
      "literal_number_integer": { "color": "{{ .cyberpunk.syntax.number }}" },
      "literal_number_integer_long": { "color": "{{ .cyberpunk.syntax.number }}" },
      "literal_number_oct": { "color": "{{ .cyberpunk.syntax.number }}" },
      "literal_string": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_affix": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_backtick": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_char": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_delimiter": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_doc": { "color": "{{ .cyberpunk.text.muted }}" },
      "literal_string_double": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_escape": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_heredoc": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_interpol": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_other": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_regex": { "color": "{{ .cyberpunk.accent.magenta }}" },
      "literal_string_single": { "color": "{{ .cyberpunk.accent.green }}" },
      "literal_string_symbol": { "color": "{{ .cyberpunk.accent.green }}" },
      "operator": { "color": "{{ .cyberpunk.semantic.warning }}" },
      "operator_word": { "color": "{{ .cyberpunk.semantic.warning }}" },
      "punctuation": { "color": "{{ .cyberpunk.semantic.warning }}" },
      "generic": { "color": "{{ .cyberpunk.text.primary }}" },
      "generic_deleted": { "color": "{{ .cyberpunk.semantic.error }}" },
      "generic_emph": { "italic": true },
      "generic_error": { "color": "{{ .cyberpunk.semantic.error }}" },
      "generic_heading": { "color": "{{ .cyberpunk.accent.pink }}", "bold": true },
      "generic_inserted": { "color": "{{ .cyberpunk.semantic.success }}" },
      "generic_output": { "color": "{{ .cyberpunk.text.muted }}" },
      "generic_prompt": { "color": "{{ .cyberpunk.text.muted }}" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "{{ .cyberpunk.accent.magenta }}", "bold": true },
      "generic_traceback": { "color": "{{ .cyberpunk.semantic.error }}" }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": { "color": "{{ .cyberpunk.accent.magenta }}", "bold": true },
  "definition_description": {
    "block_prefix": "\n🠶 ",
    "color": "{{ .cyberpunk.text.muted }}"
  },
  "html_block": {},
  "html_span": {}
}
