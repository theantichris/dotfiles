{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "cachyos") (or .packages.pacman .packages.aur .packages.go .packages.cargo) -}}
#!/bin/sh
set -eu

# Pacman packages
{{ range .packages.pacman }}
if ! pacman -Qq {{ . | quote }} >/dev/null 2>&1; then
    sudo pacman -S --needed {{ . | quote }}
fi
{{ end }}

# AUR packages
{{ range .packages.aur }}
if ! pacman -Qq {{ . | quote }} >/dev/null 2>&1; then
    shelly install aur {{ . | quote }}
fi
{{ end }}

# Go packages
{{ if .packages.go -}}
go_bin_dir="$(go env GOBIN)"
if [ -z "$go_bin_dir" ]; then
    go_bin_dir="$(go env GOPATH)/bin"
fi
{{ range .packages.go }}
if [ ! -x "$go_bin_dir/{{ .name }}" ]; then
    go install {{ .module | quote }}
fi
{{ end }}
{{ end -}}

# Cargo packages
{{ if .packages.cargo -}}
# Initialize the Rust toolchain before the first Cargo install.
if ! rustup show active-toolchain >/dev/null 2>&1; then
    rustup default stable
fi
{{ range .packages.cargo }}
if ! cargo install --list | grep -q '^{{ . }} v'; then
    cargo install --locked {{ . | quote }}
fi
{{ end }}
{{ end -}}
{{- else if eq .chezmoi.os "android" -}}
#!{{ lookPath "sh" }}
set -eu

{{ $packages := list -}}
{{ $npmPackages := list -}}
{{ range .termux.enabled -}}
{{ if not (hasKey $.packages.termux .) }}{{ fail (printf "Missing Termux packages for app: %s" .) }}{{ end -}}
{{ $app := index $.packages.termux . -}}
{{ $packages = concat $packages $app.pkg -}}
{{ $npmPackages = concat $npmPackages (get $app "npm" | default list) -}}
{{ end -}}
{{ range $packages | uniq }}
if [ "$(dpkg-query -W -f='${Status}' {{ . | quote }} 2>/dev/null || true)" != "install ok installed" ]; then
    pkg install -y {{ . | quote }}
fi
{{ end }}

{{ range $npmPackages | uniq }}
if ! npm list --global --depth=0 {{ . | quote }} >/dev/null 2>&1; then
    npm install --global {{ . | quote }}
fi
{{ end }}

{{ if has "go" .termux.enabled -}}
go_bin_dir="$(go env GOBIN)"
if [ -z "$go_bin_dir" ]; then
    go_bin_dir="$(go env GOPATH)/bin"
fi
{{ range .packages.go }}
if [ ! -x "$go_bin_dir/{{ .name }}" ]; then
    go install {{ .module | quote }}
fi
{{ end }}
{{ end -}}

{{ if has "rust" .termux.enabled -}}
{{ range .packages.cargo }}
if ! cargo install --list | grep -q '^{{ . }} v'; then
    cargo install --locked {{ . | quote }}
fi
{{ end }}
{{ end -}}
{{- end }}
