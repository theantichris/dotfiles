#!/bin/bash

MUTED=0xff{{ trimPrefix "#" .cyberpunk.text.muted }}
PINK=0xff{{ trimPrefix "#" .cyberpunk.accent.pink }}

volume="$(osascript -e 'output volume of (get volume settings)' 2>/dev/null)"
muted="$(osascript -e 'output muted of (get volume settings)' 2>/dev/null)"

if [ -z "$volume" ]; then
  volume=0
fi

icon="󰕾"
color="$MUTED"

if [ "$muted" = "true" ] || [ "$volume" -eq 0 ]; then
  icon="󰖁"
  color="$PINK"
elif [ "$volume" -lt 34 ]; then
  icon="󰕿"
elif [ "$volume" -lt 67 ]; then
  icon="󰖀"
fi

sketchybar --set "$NAME" \
  icon="$icon" \
  icon.color="$color" \
  label="${volume}%" \
  label.color="$color"
