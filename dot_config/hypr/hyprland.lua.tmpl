-- CachyOS Hyprland Configuration

require("config.animations")
require("config.autostart")
require("config.colors")
require("config.decorations")
require("config.variables")
require("config.environment")
require("config.inputs")
require("config.binds")
require("config.misc")
require("config.monitors")
require("config.windowrules")
require("config.workspaces")

-- Apply Noctalia's generated Hyprland theme when template generation is enabled.
-- Keep this optional so disabling Noctalia templates cannot break Hyprland.
local noctalia_ok, noctalia = pcall(require, "noctalia")
if noctalia_ok and type(noctalia.apply_theme) == "function" then
    noctalia.apply_theme()
end

-- Keep the focused window visually distinct from inactive windows even when
-- Noctalia's primary role is mapped to a dark surface for shell UI.
hl.config({
    general = {
        col = {
            active_border = "rgb({{ trimPrefix "#" .cyberpunk.accent.magenta }})",
        },
    },
})
