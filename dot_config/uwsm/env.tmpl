export BROWSER=brave-origin
export EDITOR={{ if eq .chezmoi.hostname "tranchion" }}"$HOME/.local/bin/ms"{{ else }}helix{{ end }}
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
export VISUAL={{ if eq .chezmoi.hostname "tranchion" }}"$EDITOR"{{ else }}helix{{ end }}
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

